/*
 * Template for local deployment values.
 *
 *   cp include/secrets.h.example include/secrets.h
 *
 * Then fill in your own values. secrets.h is gitignored; this template is not,
 * so never put real credentials or keys in it. config.h includes secrets.h when
 * present and falls back to placeholders when it is absent.
 *
 * Bealach is BLE-only: there is no server, no Wi-Fi uplink, no LTE. The owner's
 * phone is the only peer the device ever talks to, and it communicates over BLE.
 *
 * The BLE passkey is the access control for the link. ble_companion.cpp refuses
 * to compile until you choose your own, because a default passkey would be a
 * working one that everybody knows.
 */

#ifndef BEALACH_SECRETS_H
#define BEALACH_SECRETS_H

/*
 * The BLE pairing passkey, six digits. The phone types this once to bond with
 * the dongle; it is the access control for everything on the BLE link, including
 * bundle offload. Pick your own: this placeholder is public.
 */
#define BEALACH_BLE_PASSKEY 123456

#endif /* BEALACH_SECRETS_H */
